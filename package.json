{
  "name": "@vaexil/recon-map",
  "version": "1.0.0",
  "description": "Shared recon map engine (React/Next components + data layer) for the Vaexil map sites.",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@libsql/client": "^0.17.3",
    "clsx": "^2.1.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "lucide-react": "^1.14.0",
    "next": ">=16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^1.14.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED",
  "private": false,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.12.0 <23"
  }
